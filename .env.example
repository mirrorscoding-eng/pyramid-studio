# Copy to .env.local and fill in. Locally: run `npx supabase status` to see these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key, used by scripts/create-admin.mjs (never expose it to the browser)
SUPABASE_SECRET_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=
